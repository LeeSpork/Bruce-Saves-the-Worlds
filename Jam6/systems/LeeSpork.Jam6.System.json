/*
```py
import math
def polar_to_cartesian(r, ϕ):
    x = r * math.cos(ϕ)
    y = r * math.sin(ϕ)
    return x, y

ids = ["THE_SUN", "DRYDOCK", "SUN_STATION", "TIME_DISPLACEMENT_DEVICE", "FUTURE_PLANET", "BRUCE", "COREY"]
lines2=[]
for i in range(len(ids)):
    x, y = polar_to_cartesian(300, math.pi * 2 * (i/len(ids)))
    lines=[]
    lines.append("		{")
    lines.append(f'			"id": "LEESPORK_JAM6_{ids[i]}",')
    lines.append(f'			"position": {{"x": {-x}, "y": {y}}}')
    lines.append("		}")
    lines2.append("\n".join(lines))

print(',\n'.join(lines2))

```
